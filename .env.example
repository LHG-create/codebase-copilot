# ===== 对话模型 =====
# 可选：deepseek / dashscope / openai / ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ===== 向量模型 =====
# DeepSeek 没有 embedding 接口，所以这里单独配置
# 可选：dashscope / openai / ollama
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3

# ===== API Key（按需填写，用哪个填哪个）=====
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ===== 检索参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
